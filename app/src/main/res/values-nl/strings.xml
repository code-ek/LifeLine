    <string name="location_explanation">LifeLine volgt NIET uw locatie.\n\nLocatiediensten zijn vereist voor Bluetooth-scanning.</string>
    <string name="location_needs_for">LifeLine heeft locatiediensten nodig voor:</string>
    <string name="location_needs_bullets">• Bluetooth-apparaat scanning\n• Ontdekken van gebruikers in de buurt op meshnetwerk\n• Geen tracking of locatieverzameling</string>
    <string name="open_location_settings">Locatie-instellingen openen</string>
    <string name="check_again">Opnieuw controleren</string>
    <string name="location_services_unavailable">Locatiediensten niet beschikbaar</string>
    <string name="location_unavailable_explanation">Locatiediensten zijn niet beschikbaar op dit apparaat. Dit is ongebruikelijk omdat locatiediensten standaard zijn op Android-apparaten.\n\nLifeLine heeft locatiediensten nodig om Bluetooth-scanning goed te laten werken (Android-vereiste). Zonder dit kan de app geen gebruikers in de buurt ontdekken.</string>
    <string name="checking_location_services">Locatiediensten controleren…</string>
    <string name="bluetooth_needs_for">LifeLine heeft Bluetooth nodig om:</string>
    <string name="bluetooth_needs_bullets">• Gebruikers in de buurt te ontdekken\n• Meshnetwerkverbindingen te maken\n• Berichten te verzenden en ontvangen\n• Te werken zonder internet of servers</string>
    <string name="enable_bluetooth">Bluetooth inschakelen</string>
    <string name="bluetooth_not_supported">Bluetooth niet ondersteund</string>
    <string name="bluetooth_unsupported_explanation">Dit apparaat ondersteunt geen Bluetooth Low Energy (BLE), wat vereist is om LifeLine te laten functioneren.\n\nLifeLine heeft BLE nodig om meshnetwerken te maken en te communiceren met apparaten in de buurt zonder internet.</string>
